# Copier ce fichier vers .env.local puis renseigner les valeurs.
# .env.local n'est jamais versionné (voir .gitignore).

# --- Supabase (obligatoire) --------------------------------------------------
# Tableau de bord Supabase → Project Settings → API Keys.
# Ces deux valeurs sont publiques par conception : la sécurité repose sur la
# Row Level Security, pas sur leur confidentialité.
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# --- Application --------------------------------------------------------------
# Adresse publique de l'application, utilisée dans les liens envoyés par e-mail.
# En développement : http://localhost:3000. En production : votre domaine.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Open Food Facts (facultatif) ----------------------------------------------
# Gratuit et sans clé. Open Food Facts demande un User-Agent qui identifie
# l'application et donne un contact : « NomApp/Version (adresse e-mail) ».
# OPEN_FOOD_FACTS_USER_AGENT=Elan/0.4 (vous@exemple.be)

# --- À venir (non lues par le code pour l'instant) ----------------------------
# IA (photo de repas, coach) : non activée, aucun service payant n'est utilisé.
# AI_PROVIDER=
# Phase 6 — suppression de compte et tâches serveur. Contourne la RLS :
# ne jamais l'exposer au navigateur.
# SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx
